{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkGraph",
  "version": "0.1.0",
  "identifier": "app.inkgraph.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @inkgraph/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @inkgraph/ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "InkGraph",
        "width": 1320,
        "height": 840,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
